# CATSight.AI configuration. Copy to .env (development) or .env.prod (production).
# .env and .env.prod are gitignored: never commit real keys.

# --- Models ---------------------------------------------------------------------
# Each organization brings its own provider and key (Settings → AI provider in the app):
# OpenRouter or OpenAI with the organization's key, or this server's Ollama, which the
# super admin enables per organization. Nothing here is needed for those.
# OLLAMA_BASE_URL=http://ollama:11434          # the server's Ollama (docker compose --profile ollama)
# EMBEDDING_DIMENSIONS=1024                    # every organization's embedding model must return this many values
# Text extraction: marker (default where installed: LOCAL_OCR=1 builds), vision, docling, markitdown
# DEFAULT_TEXT_EXTRACTOR=marker
# MARKER_USE_LLM=1                             # Marker refines tables/forms/handwriting with the organization's OCR model
# SURYA_INFERENCE_URL=http://ocr:8080/v1       # Marker 2's OCR model server (docker-compose.prod.yml)

# --- Django (production) --------------------------------------------------------
# DJANGO_SECRET_KEY=   # python -c "import secrets; print(secrets.token_urlsafe(50))"
# Encrypts organizations' API keys at rest; changing it makes the saved keys unreadable.
# FIELD_ENCRYPTION_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DJANGO_ALLOWED_HOSTS=catsight.mjcarnaje.com,localhost,backend
PUBLIC_URL=http://localhost:3000

# --- Database (production; development uses postgres/postgres) -----------------
# POSTGRES_DB=catsight
# POSTGRES_USER=catsight
# POSTGRES_PASSWORD=

# --- Accounts -------------------------------------------------------------------
# Super admin created/updated on start-up in production (manage.py ensure_admin).
# The super admin creates organizations; organization admins invite members.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Comma-separated domains allowed to register; empty allows any email. An invitation
# lets its recipient register with any address.
ALLOWED_EMAIL_DOMAINS=
# INVITATION_TTL_DAYS=7

# --- Email (invitations) --------------------------------------------------------
# Without EMAIL_HOST, development prints emails to the backend's log; admins can
# always copy an invitation's link instead.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=CATSight <no-reply@example.com>

# --- Public demo ----------------------------------------------------------------
# One-click guest accounts in the organization DEMO_ORG (its slug), plus per-visitor
# limits there (its admins and every other organization are never limited)
DEMO_MODE=0
# DEMO_ORG=demo
# 0 turns uploads off for everyone but organization admins (a curated library to chat with)
UPLOADS_ENABLED=1
# GUEST_TTL_HOURS=24          # guests and their uploads are deleted after this
# DEMO_DAILY_UPLOADS=3        # PDFs per visitor per 24 h
# DEMO_DAILY_MESSAGES=25      # questions per visitor per 24 h
# DEMO_LIBRARY_PAGE_LIMIT=600 # pages OCR'd across all visitors, ever
# DEMO_MAX_UPLOAD_MB=10      # per file, for visitors
# DEMO_MAX_UPLOAD_PAGES=15
# MAX_UPLOAD_MB=30           # per file, for admins (and everyone outside demo mode)
# MAX_UPLOAD_PAGES=100
